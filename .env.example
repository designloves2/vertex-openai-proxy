# ============================================================================
# Google Cloud Configuration for Vertex AI Gemini Server
# ============================================================================

# REQUIRED: Your Google Cloud Project ID
# Find this in: https://console.cloud.google.com/home/dashboard
# Look for "Project ID" (e.g., "my-project-12345")
GOOGLE_CLOUD_PROJECT_ID=your-project-id-here

# REQUIRED: The location for Vertex AI (closest region to you)
# Common options: us-central1, us-east5, europe-west1, asia-northeast1
# Find available regions at: https://cloud.google.com/vertex-ai/generative-ai/docs/learn/regions
GOOGLE_CLOUD_LOCATION=us-central1

# REQUIRED: The Gemini model to use
# Common models:
#   - gemini-2.0-flash-001 (fast, good for most tasks)
#   - gemini-1.5-pro-002 (slower, more capable)
#   - gemini-1.5-flash-002 (balanced)
# Find all models at: https://cloud.google.com/vertex-ai/generative-ai/docs/learn/models
GOOGLE_CLOUD_MODEL_ID=gemini-2.0-flash-001

# OPTIONAL: Path to your Service Account JSON key file
# Only needed if you have an existing key file
# If you don't have one, use: gcloud auth application-default login
# Examples:
#   - Windows: C:\Users\YourName\Downloads\my-service-account-key.json
#   - Relative to project root: ./service-account-key.json
# GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# Optional: Server port (default is 3000)
PORT=3000

# ============================================================================
# AUTHENTICATION OPTIONS (choose one):
# ============================================================================
#
# OPTION 1 - Local Development with gcloud CLI (RECOMMENDED):
#   1. Install Google Cloud CLI: https://cloud.google.com/sdk/docs/install
#   2. Run: gcloud auth application-default login
#   3. Leave GOOGLE_APPLICATION_CREDENTIALS unset or empty
#
# OPTION 2 - Existing Service Account Key:
#   1. Set GOOGLE_APPLICATION_CREDENTIALS to your key file path
#   2. Key creation is disabled in your organization, so you need an existing key
#
# OPTION 3 - Running on Google Cloud (Compute Engine, Cloud Run, etc.):
#   1. The service automatically has credentials - no setup needed!
# ============================================================================